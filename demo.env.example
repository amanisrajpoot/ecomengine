# Demo credentials template — run `pnpm demo:seed` to generate demo.env with real tenant UUID

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TENANT_ID=run-pnpm-demo-seed-to-fill

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

DEMO_CUSTOMER_EMAIL=customer@demo.com
DEMO_MERCHANT_EMAIL=merchant@demo.com
DEMO_RIDER_EMAIL=rider@demo.com
DEMO_PASSWORD=Demo123!
