# Production / full-stack Docker deploy
# Copy: cp .env.production.example .env
# Then edit PUBLIC_HOST and secrets before: docker compose -f docker-compose.prod.yml up -d --build

# --- Public URLs (browser must reach these) ---
# Replace with your server IP or domain. Rebuild frontends after changing API URL.
PUBLIC_HOST=localhost
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# --- Ports exposed on the host ---
API_PORT=8000
CUSTOMER_PORT=3000
MERCHANT_PORT=3001
RIDER_PORT=3002
ADMIN_PORT=3003

# --- Database (change password in production) ---
POSTGRES_USER=commerce
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=commerce

# --- Backend ---
ENVIRONMENT=production
JWT_SECRET=change-me-long-random-jwt-secret
OTP_ECHO_IN_RESPONSE=false
APP_NAME=commerce-engine

DATABASE_URL=postgresql+asyncpg://commerce:change-me-strong-password@postgres:5432/commerce
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=commerce
S3_REGION=us-east-1

# ONDC / notifications / payments (mock OK for demo deploys)
ONDC_MOCK=true
ONDC_SEND_CALLBACKS=false
NOTIFICATIONS_DEFAULT_CHANNEL=sms_mock
PAYMENTS_DEFAULT_PROVIDER=cashfree
PAYMENTS_MOCK=true
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
LEDGER_DEFAULT_COMMISSION_BPS=1000

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
