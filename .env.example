# Backend
DATABASE_URL=postgresql+asyncpg://commerce:commerce@localhost:5432/commerce
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=commerce
S3_REGION=us-east-1
APP_NAME=commerce-engine
APP_VERSION=0.14.0
ENVIRONMENT=development
JWT_SECRET=dev-only-change-me-commerce-engine-jwt-secret
OTP_ECHO_IN_RESPONSE=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Payments (multi-gateway; Cashfree first + COD)
PAYMENTS_DEFAULT_PROVIDER=cashfree
PAYMENTS_MOCK=true
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Ledger
LEDGER_DEFAULT_COMMISSION_BPS=1000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
